# Brevo (API key em https://app.brevo.com/settings/keys/api)
# Obrigatório para o formulário de proposta técnica (/api/send-proposta)
BREVO_API_KEY=

# Opcional: e-mail remetente (deve ser um remetente verificado no Brevo)
# BREVO_SENDER_EMAIL=noreply@seudominio.com.br
# BREVO_SENDER_NAME=Landing Mob Parceiros

# Meta/WhatsApp Business API – token de acesso permanente (backend apenas)
# Obrigatório para resposta automática no webhook (/api/webhook). Configure na Vercel > Environment Variables.
# WHATSAPP_ACCESS_TOKEN=
